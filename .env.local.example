# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=

# Cashfree
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_API_VERSION=2026-01-01
# "sandbox" or "production" -- keep both in sync, and CASHFREE_BASE_URL with it
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# Auth secrets (generate with: openssl rand -hex 32)
OTP_SECRET=
PDF_TOKEN_SECRET=

# Visitor counter hashing salt (generate with: openssl rand -hex 32).
# Optional — falls back to OTP_SECRET, then a dev-only default, if unset.
VISITOR_HASH_SALT=

# Transactional email via SMTP (e.g. Gmail: smtp.gmail.com, port 587, an
# App Password -- not your normal Gmail password -- as SMTP_PASSWORD)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# SMS OTP provider (optional, leave blank to use the stub)
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
